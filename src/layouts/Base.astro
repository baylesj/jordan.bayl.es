---
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/atkinson-hyperlegible-mono";
import "@fontsource-variable/geologica/shrp.css";
import "bayl.es-style/eopsin.min.css";
// The shared theme switch, inlined so a chosen theme is applied before the page draws.
import themeScript from "bayl.es-style/js/theme.js?raw";
// The galaxy behind the header: one map for every bayl.es site, with jordan's star (Alkaid) lit.
import galaxyScript from "bayl.es-style/js/galaxy.js?raw";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  shareDescription?: string;
}

const { title, description, shareDescription = description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeScript} />
  </head>
  <body data-site="jordan">
    <slot name="header" />
    <main>
      <slot />
      <footer>
        <span>
          &copy; {new Date().getFullYear()} {title}
        </span>
        <a href="https://style.bayl.es">style.bayl.es</a>
      </footer>
    </main>
    <script is:inline set:html={galaxyScript} />
  </body>
</html>
