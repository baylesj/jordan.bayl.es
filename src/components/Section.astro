---
interface Props {
  id: string;
  title: string;
  order: number;
}

const { id, title, order } = Astro.props;
const number = String(order).padStart(2, "0");
---

<section class="split" aria-labelledby={id}>
  <h2 class="label" id={id}>
    <span class="n">{number}</span>
    {title}
  </h2>
  <div class="prose">
    <slot />
  </div>
</section>
