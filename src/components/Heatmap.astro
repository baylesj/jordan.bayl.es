---
/** The last year of Chromium/WebRTC/Android code reviews, drawn by gerritoscope. */
const review = "https://chromium-review.googlesource.com/q/owner:jophba@chromium.org";
const image = "https://raw.githubusercontent.com/baylesj/baylesj/main/gerrit-heatmap.svg";
---

<a class="heatmap" href={review}>
  <img
    src={image}
    width="740"
    height="140"
    loading="lazy"
    alt="Contribution heatmap of the last year of Chromium, WebRTC and Android code reviews, from gerritoscope"
  />
</a>

<style>
  .heatmap {
    display: block;
    margin: 18px 0 4px;
    border: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
</style>
