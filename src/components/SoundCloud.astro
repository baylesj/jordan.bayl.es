---
/** SoundCloud's profile player for Chasma Sound, with the controls in the site's pink. */
const params = new URLSearchParams({
  url: "https://api.soundcloud.com/users/228364454",
  color: "#e0457b",
  auto_play: "false",
  hide_related: "true",
  show_comments: "false",
  show_user: "true",
  show_reposts: "false",
  show_teaser: "false",
  visual: "false",
});
---

<div class="player">
  <iframe
    title="Chasma Sound on SoundCloud"
    loading="lazy"
    allow="autoplay; encrypted-media"
    src={`https://w.soundcloud.com/player/?${params}`}
  ></iframe>
</div>

<style>
  .player {
    margin: 18px 0 6px;
    overflow: hidden;
    border-radius: 8px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 300px;
    border: 0;
  }
</style>
