{
  "name": "jordan.bayl.es",
  "version": "1.0.0",
  "private": true,
  "description": "Jordan Bayles's personal site, https://jordan.bayl.es",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run lint",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\" && prettier --check .",
    "format": "prettier --write . && eslint --fix . && stylelint --fix \"src/**/*.{css,astro}\""
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "astro": "^7.3.8",
    "bayl.es-style": "github:baylesj/bayl.es-style#v1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
